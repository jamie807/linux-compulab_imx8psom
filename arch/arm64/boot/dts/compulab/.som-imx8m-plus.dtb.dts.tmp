        <&clk 130>,
        <&clk 129>;
    assigned-clock-parents = <&clk 54>,
        <&clk 58>,
        <&clk 59>;
    assigned-clock-rates = <0>, <100000000>, <125000000>;
    nvmem-cells = <&eth_mac2>;
    nvmem-cell-names = "mac-address";
    nvmem_macaddr_swap;
    intf_mode = <&gpr 0x4>;
    status = "disabled";
   };
